    "ci": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
